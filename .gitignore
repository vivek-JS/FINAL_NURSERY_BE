node_modules/
public/images/*
!public/images/.gitkeep
public/uploads/*
!public/uploads/.gitkeep
# Ignore MongoDB binaries and archives
mongodb-macos-x86_64-7.0.5/
mongodb-macos-x86_64-7.0.5.tgz

# Ignore Terraform directories
deployment/aws/terraform/.terraform/
deployment/aws/terraform/cost-optimized/.terraform/

# Environment variables and secrets
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.backup
*.env

# WhatsApp Selenium bot – Chrome profile (session data, do not commit)
scripts/whatsapp-chrome-profile/
whatsapp-profile/

# whatsapp-web.js LocalAuth (dev); production uses WHATSAPP_SESSION_PATH outside repo
data/whatsapp-auth/
.wwebjs_auth/

# Campaign run PIDs
.campaign-pids/

# Generated dealer reports (local)
scripts/exports/*.xlsx

# ICICI keys — NEVER commit private.key or icici_public.crt
keys/private.key
keys/*.key
keys/*.pem
keys/icici_public.crt
keys/*.p12
keys/*.jks

# ICICI banking certificates — never commit private keys
config/certs/*.key
config/certs/*.pem
config/certs/icici_public.crt
config/certs/*.jks
config/certs/*.p12
.wwebjs_auth/
