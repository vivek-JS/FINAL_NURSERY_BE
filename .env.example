# ICICI EazyPay — Sandbox / UAT
ENV_TYPE=UAT

# API key from ICICI portal (also may be embedded in sdk-api-config.json — keep both in sync)
EAZYPAY_API_KEY=

# Keystore and crypto (required for real SDK; optional if EAZYPAY_USE_STUB=true)
EAZYPAY_KEYSTORE_PATH=./certs/your-keystore.jks
EAZYPAY_KEYSTORE_PASSWORD=
EAZYPAY_KEYSTORE_ALIAS=
EAZYPAY_PRIVATE_PEM_PATH=./certs/private.pem

# Merchant / terminal (sandbox example — use your values from bank)
EAZYPAY_MERCHANT_ID=118449
EAZYPAY_TERMINAL_ID=5411
EAZYPAY_SUB_MERCHANT_ID=118449

# Copy apiId for the QR API from config/sdk-api-config.json (eazypay module) after you replace file with bank copy
EAZYPAY_QR_API_ID=

# Path to sdk-api-config.json (default: ./config/sdk-api-config.json relative to project root)
EAZYPAY_SDK_CONFIG_PATH=./config/sdk-api-config.json

# Set true to log EazyPay flow to console (winston)
IS_LOGGER_ENABLE=true

# UI/dev only: use stub SdkClient that returns a fake UPI string (no bank certs). Never enable in production.
EAZYPAY_USE_STUB=true

# Optional: max amount for validation (default very high)
# EAZYPAY_MAX_AMOUNT=99999999.99

# EazyPay transaction status (QR polling) — copy apiId from sdk-api-config.json (eazypay module)
EAZYPAY_STATUS_API_ID=

# ICICI Account Services / bank statement (corporate module — confirm apiId in sdk-api-config.json)
ICICI_STATEMENT_MODULE=corporate
ICICI_STATEMENT_API_ID=
ICICI_ACCOUNT_ID=
# Dev: stub statement rows without calling SDK (never in production)
ICICI_STATEMENT_USE_STUB=true
ICICI_STATEMENT_MAX_RANGE_DAYS=90
