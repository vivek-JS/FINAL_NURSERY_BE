# FINAL_NURSERY_BE — environment variables
#
# This file documents the variables required to run the core server and the
# Face Recognition Attendance app features. FINAL_NURSERY_BE is a large,
# pre-existing ERP backend with many optional integrations (WhatsApp/WATI,
# Exotel SMS, Cloudinary, ICICI EazyPay, etc.) that are NOT required for the
# attendance features below — see the existing `.env` on the server for the
# full list if you're extending one of those other modules.
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# -----------------------------------------------------------------------------
# Core server
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=8000
# Base URL other services use to build absolute links back to this API
# (e.g. locally-stored image URLs). Defaults to http://localhost:$PORT in dev.
BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# MongoDB (see index.js resolveMongoUrl for the exact precedence)
#   development/staging → MONGO_URL (falls back to STAGE_MONGO_URL / MONGODB_URI)
#   NODE_ENV=production → PROD_MONGO_URL (falls back to MONGO_URL / MONGODB_URI)
# -----------------------------------------------------------------------------
MONGO_URL=mongodb://localhost:27017/nursery
# STAGE_MONGO_URL=
# PROD_MONGO_URL=

# -----------------------------------------------------------------------------
# Auth / JWT (shared by every authenticated route, including the attendance app)
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string
# Falls back to JWT_SECRET + "_refresh" if unset:
# REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=7d

# -----------------------------------------------------------------------------
# Face Recognition Attendance app
# -----------------------------------------------------------------------------
# AES-256-GCM key used to encrypt stored face embeddings at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FACE_EMBEDDING_ENCRYPTION_KEY=replace-with-a-64-char-hex-string

# Euclidean / cosine similarity threshold for InsightFace (via FastAPI microservice).
# Legacy face-api.js used Euclidean distance — lower was stricter. InsightFace uses
# cosine similarity — higher is a better match. Defaults to 0.45.
FACE_MATCH_THRESHOLD=0.45
FACE_DUPLICATE_THRESHOLD=0.55

# InsightFace FastAPI microservice (see ../face-service/)
FACE_SERVICE_URL=http://127.0.0.1:8020
FACE_SERVICE_API_KEY=dev-face-key-change-me
FACE_SERVICE_TIMEOUT_MS=30000

# Geofence validation for mobile attendance
GEOFENCE_ENABLED=true
DEFAULT_ALLOWED_RADIUS_METERS=200
MAX_GPS_ACCURACY_METERS=50

# Device registration — one active device per employee when true
ENFORCE_SINGLE_DEVICE=true

# Attendance rules
MIN_MINUTES_BETWEEN_CHECKIN_CHECKOUT=30
MAX_OFFLINE_SUBMISSION_DELAY_MINUTES=15
ATTENDANCE_TIMEZONE=Asia/Kolkata
# Comma-separated IST dates YYYY-MM-DD
# ATTENDANCE_HOLIDAYS=2026-01-26,2026-08-15

# Longest edge (px) an uploaded photo is downscaled to before face detection.
# TinyFaceDetector resizes its input to 416px internally, so larger values only
# add latency and memory pressure. Minimum 416; defaults to 800.
FACE_DETECT_MAX_DIMENSION=800

# If "true", the original selfie image is also saved to local disk
# (uploads/attendance-selfies/<userId>/) and its URL is stored on the
# attendance record. Defaults to disabled — only embeddings are ever
# required for matching.
ENABLE_RAW_FACE_STORAGE=false

# 9:30 AM IST daily "you haven't checked in yet" push reminder.
# Set to "false" to disable entirely; override the schedule with cron syntax.
ATTENDANCE_REMINDER_ENABLED=true
ATTENDANCE_REMINDER_CRON=30 9 * * *

# Forgot-password OTP delivery for the attendance app reuses the existing
# WATI WhatsApp integration below. If WATI_URL/WATI_TOKEN aren't configured,
# OTPs are logged to the server console instead of sent (dev-only fallback).
# FACE_ATTENDANCE_OTP_TEMPLATE_NAME=

# -----------------------------------------------------------------------------
# WhatsApp (WATI) — used for attendance forgot-password OTPs and other
# existing ERP alerts. Optional for local dev (falls back to console logging).
# -----------------------------------------------------------------------------
# WATI_URL=https://live-mt-server.wati.io/<tenant-id>
# WATI_TOKEN=Bearer <token>
# WATI_ORDER_PLACED_TEMPLATE=order_placed_revamped
# WATI_PAYMENT_WHATSAPP_ENABLED=true
# WHATSAPP_ALERTS_ENABLED=true
# WHATSAPP_ADMIN_NUMBERS=919876543210

# -----------------------------------------------------------------------------
# Local UPI receipt OCR (see python/ocr_service.py + services/ocrService.js)
# -----------------------------------------------------------------------------
# Base URL of the local PaddleOCR microservice (pm2 app "ocr-service").
# Defaults to http://127.0.0.1:8010 if unset — only override for local dev on
# a different port. Never point this at a public URL.
# PADDLEOCR_SERVICE_URL=http://127.0.0.1:8010

# Optional fallback OCR if the local PaddleOCR service is down/unusable.
# GEMINI_API_KEY=
