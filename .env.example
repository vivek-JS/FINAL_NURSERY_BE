# Copy to .env and fill values. Never commit .env.

NODE_ENV=development

# Non-production: one of these (see index.js)
MONGO_URL=
STAGE_MONGO_URL=
MONGODB_URI=

# Production API host: set NODE_ENV=production and use prod cluster
PROD_MONGO_URL=

PORT=8000
PUBLIC_DIR=public
TOKEN_EXPIRY=1d

JWT_SECRET=
PRIVATE_KEY=

# Comma-separated origins for CORS (app also allows *.rambiotechplants.com by pattern)
ALLOWED_ORIGINS=http://localhost:3000,https://erp.rambiotechplants.com

# WhatsApp ERP admin alerts (whatsapp-web.js — comma-separated 10-digit Indian numbers)
WHATSAPP_ALERTS_ENABLED=true
WHATSAPP_ADMIN_NUMBERS=9876543210,9876543211
WHATSAPP_SESSION_PATH=/var/www/erp-whatsapp/.wwebjs_auth
# Alert engine thresholds
WHATSAPP_ALERT_BIG_ORDER_QTY=10000
WHATSAPP_ALERT_SLOT_LOW_UTIL_PCT=80
WHATSAPP_ALERT_SLOT_LOW_ABS=1000
WHATSAPP_ALERT_SLOT_HIGH_AVAIL_PCT=60
WHATSAPP_ALERT_SLOT_HIGH_ABS=5000
WHATSAPP_ALERT_COOLDOWN_MS=21600000
WHATSAPP_ALERT_SLOT_SCAN_CRON=0 9,14,18 * * *
WHATSAPP_ALERT_OPS_CRON=0 8 * * *

# Local database backups (SUPER_ADMIN API + server-side storage)
BACKUP_DIR=
BACKUP_RETENTION_DAYS=30

# Central ledger engine (shadow posting + reconciliation)
# FINANCE_SHADOW_ENABLED=false
# FINANCE_STRICT_DEALER_LEDGER=true
# FINANCE_DERIVE_DEALER_WALLET=true
# FINANCE_USE_PROJECTION=false
# FINANCE_SHADOW_RECONCILE_CRON=30 2 * * *
# FINANCE_CRON_TZ=Asia/Kolkata
# One-time historical central ledger: npm run backfill:central-ledger [-- --dry-run] [-- --since=YYYY-MM-DD]

# ── ICICI Corporate API (src/services/iciciApiService.js) ─────────────────
ICICI_BASE_URL=https://apibankingonesandbox.icicibank.com
ICICI_USE_STUB=true
ICICI_AGGRID=
ICICI_AGGRNAME=
ICICI_CORPID=
ICICI_USERID=
ICICI_URN=
ICICI_ACCOUNT_NO=
ICICI_API_KEY=
ICICI_PRIVATE_KEY_PATH=./keys/private.key
ICICI_PUBLIC_CERT_PATH=./keys/public.crt
ICICI_BANK_PUBLIC_CERT_PATH=./keys/icici_public.crt
ICICI_LOG_LEVEL=info

# ── ICICI Corporate Banking (modules/banking — optional extended reconcile) ─
# Phase 1: Registration → Statement → Reconcile
ICICI_CORPORATE_ENV=UAT
ICICI_CORPORATE_USE_STUB=true
ICICI_CORPORATE_USE_HTTP=true
ICICI_CORPORATE_BASE_URL=https://apibankingonesandbox.icicibank.com
ICICI_CORPORATE_ID=
ICICI_CORPORATE_USER_ID=
ICICI_AGGREGATOR_ID=
ICICI_ACCOUNT_ID=
ICICI_CORPORATE_API_KEY=
ICICI_CORPORATE_CLIENT_ID=
ICICI_PRIVATE_KEY_PATH=config/certs/private.key
ICICI_PUBLIC_CERT_PATH=config/certs/public.crt
ICICI_BANK_PUBLIC_CERT_PATH=config/certs/icici_public.crt
ICICI_WEBHOOK_HMAC_SECRET=
ICICI_IP_WHITELIST=
ICICI_BANKING_CRON_ENABLED=false
ICICI_BANKING_CRON=0 6 * * *
ICICI_BANKING_LOOKBACK_DAYS=3
BANKING_AUTO_VERIFY_THRESHOLD=85
BANKING_FUZZY_THRESHOLD=60
BANKING_LOG_LEVEL=info

# ICICI EazyPay (QR / UPI — separate from Corporate HTTP)
# EAZYPAY_USE_STUB=true
# EAZYPAY_MERCHANT_ID=
# EAZYPAY_KEYSTORE_PATH=
# EAZYPAY_PRIVATE_PEM_PATH=

# Optional: WATI, Exotel, etc. — see app and payment routes
